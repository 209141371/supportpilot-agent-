# The application currently uses the DeepSeek OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional: retained for compatibility with OpenAI tooling.
OPENAI_API_KEY=your_openai_api_key_here

# Web API authentication. Set a long random value in production.
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_ACCESS_TOKEN_MINUTES=480
